# アカウント情報
PRIVATE_KEY=あなたのウォレットの秘密鍵（0xプレフィックスなし）

# ネットワーク情報
AMOY_RPC_URL=https://rpc-amoy.publicnode.com
POLYGON_RPC_URL=https://polygon-rpc.com

# API キー
POLYGONSCAN_API_KEY=あなたのPolygonscanのAPIキー

# デプロイ設定
INITIAL_OWNER=トークンの所有権へ割り当てるアドレス（0xプレフィックス付き）
INITIAL_SUPPLY=1000000000000000000000000
MAX_SUPPLY=10000000000000000000000000
AIRDROP_AMOUNT=100000000000000000000